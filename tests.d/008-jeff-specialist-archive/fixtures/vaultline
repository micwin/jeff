#!/usr/bin/env bash
# Test adapter: emulates the minimal Vaultline surface Jeff needs.

set -euo pipefail

if [[ ${1-} == "version" ]]; then
	printf '999.0.0\n'
	exit 0
fi

if [[ ${1-} == "health" ]]; then
	exit 0
fi

if [[ ${1-} == "store" && ${2-} == "show" ]]; then
	printf '{"name":"jeff","path":"%s/jeff/memcastle/jeff/vaultline/store","available":true,"sealed":false}\n' "$XDG_DATA_HOME"
	exit 0
fi

if [[ ${1-} == "secret" && ${2-} == "get" ]]; then
	case ${3-} in
	ai:codex.context.gov.id) printf '11111111-1111-1111-1111-111111111111\n' ;;
	ai:codex.context.dirty.id) printf '22222222-2222-2222-2222-222222222222\n' ;;
	*) exit 1 ;;
	esac
	exit 0
fi

printf 'unexpected vaultline arguments: %s\n' "$*" >&2
exit 2
